#!/usr/bin/env bash
set -eo pipefail -u

WIKI=
if [[ ${1:-} == '--wiki' ]]; then
  WIKI=.wiki
  shift
fi

while read -r name owner; do

  if [[ ${1:-} == "$name" ]]; then

    FOUND=1

    if [[ ${2:-} != '' ]]; then
      DIR=~/code/$2
    elif [[ $name =~ ^(apsis)(-)(.*)$ ]]; then
      DIR=~/code/apsis/${BASH_REMATCH[3]}
    elif [[ $name == efficy-* ]]; then
      DIR=~/code/efficy/${name#efficy-}
    else
      DIR=~/code/$name
    fi

    [[ $WIKI && ${2:-} == '' ]] && DIR+=$WIKI

    URL=git@github.com:$owner/$name$WIKI.git

    if [[ $WIKI && ! -d $DIR ]] && ! git ls-remote "$URL" &>/dev/null; then
      printf '\e[33m \e[37mno wiki in \e[36m%s\e[0m\n' "$name" >&2
      exit 1
    fi

    printf '\e[33m \e[37mfetch \e[36m%s \e[90m· \e[35m<C-f> \e[37mcd\e[0m\n' "${DIR/#$HOME/\~}"

    if [[ -d $DIR ]]; then
      pushd "$DIR" >/dev/null
      git show-ref --quiet --verify refs/heads/main && BRANCH=main || BRANCH=master
      git checkout --quiet "$BRANCH" && git pull --prune --quiet
      popd >/dev/null
    else
      mkdir -p "${DIR%/*}"
      git clone --quiet "$URL" "$DIR"
    fi

    echo "$DIR" >/tmp/fetch-dir # my-fetch-cd

  fi

done <"$XDG_CACHE_HOME/fetch/repos"

[[ ${FOUND:-} ]] || {
  printf '\e[33m \e[37munknown repo \e[36m%s\e[0m\n' "${1:-}" >&2
  exit 1
}
